{
  "info": {
    "name": "Products API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "All products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "Search - jacket",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/search/jacket",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "search",
            "jacket"
          ]
        }
      }
    },
    {
      "name": "Search - no results",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/search/zzzz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "search",
            "zzzz"
          ]
        }
      }
    },
    {
      "name": "Price max 15",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/price/15",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "price",
            "15"
          ]
        }
      }
    },
    {
      "name": "Price invalid (422)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/price/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "price",
            "abc"
          ]
        }
      }
    },
    {
      "name": "Rating min 4.6",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rating/4.6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rating",
            "4.6"
          ]
        }
      }
    },
    {
      "name": "Rating out of range (422)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rating/6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rating",
            "6"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    }
  ]
}